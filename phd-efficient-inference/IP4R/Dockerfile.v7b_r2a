FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server_v7b_r2a/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY server_v7b_r2a/ ./server_v7b_r2a/

# Model paths — override with -e P1_MODEL=... or via docker-compose environment
ENV P1_MODEL=/models/p1_best.pt
ENV ELEM_MODEL=/models/elem_best.pt

EXPOSE 8084

CMD ["python", "-m", "uvicorn", "server_v7b_r2a.app:app", "--host", "0.0.0.0", "--port", "8084"]
